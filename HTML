<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>STTI NIIT I-Tech - Selamat Datang</title>
    <!-- Menghubungkan ke file CSS eksternal -->
    <link rel="stylesheet" href="akademik.css">
    <!-- Font Awesome untuk Icon -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
</head>
<body>

    <!-- 1. NAVIGATION BAR -->
    <nav class="navbar">
        <div class="nav-logo">
            <i class="fas fa-graduation-cap"></i>
            <span>STTI NIIT I-Tech</span>
        </div>
        <div class="nav-links">
            <a href="#" class="active">Beranda</a>
            <a href="#">Profil</a>
            <a href="#">Program Studi</a>
            <a href="#">Informasi</a>
            <a href="#">Kontak</a>
        </div>
    </nav>

    <!-- 2. HERO SECTION -->
    <header class="hero">
        <div class="hero-content">
            <h1>Selamat Datang di <br>STTI NIIT I-Tech</h1>
            <p>Membangun masa depan dengan teknologi dan pendidikan berkualitas.</p>
            <button class="btn-primary">
                <span>Jelajahi Program Studi</span>
                <i class="fas fa-arrow-right"></i>
            </button>
        </div>
        <div class="hero-visual">
            <div class="hero-image-wrapper">
                <!-- Mengambil gambar gedung langsung dari folder images -->
                <img src="images/gedung.jpg" alt="Gedung STTI NIIT I-Tech">
                <div class="hero-badge-overlay">
                    <i class="fas fa-graduation-cap"></i>
                    <h2>STTI NIIT I-Tech</h2>
                </div>
            </div>
        </div>

    </header>

    <!-- 3. TENTANG KAMI & FITUR UNGGULAN -->
    <main class="main-container">
        <!-- Tentang Kami -->
        <div class="about-section">
            <h2>Tentang Kami</h2>
            <p>STTI NIIT I-Tech adalah perguruan tinggi yang berfokus pada pengembangan teknologi informasi dan komunikasi untuk menghasilkan lulusan yang kompeten dan siap bersaing di dunia kerja.</p>
            <p>Dengan kurikulum yang relevan dan didukung oleh dosen profesional, kami berkomitmen untuk memberikan pendidikan terbaik bagi setiap mahasiswa.</p>
            <p>Bergabunglah bersama kami dan jadilah bagian dari generasi inovatif yang siap menghadapi tantangan era digital.</p>
        </div>

        <!-- Card Program Studi -->
        <div class="card">
            <div class="card-icon icon-blue">
                <i class="fas fa-laptop-code"></i>
            </div>
            <h3>Program Studi Unggulan</h3>
            <p class="card-text">Kami menawarkan program studi yang relevan dengan kebutuhan industri, seperti Sistem Informasi, Teknik Informatika, dan bidang teknologi lainnya.</p>
            <button class="btn-outline">Lihat Program Studi →</button>
        </div>

        <!-- Card Fasilitas -->
        <div class="card">
            <div class="card-icon icon-green">
                <i class="fas fa-users"></i>
            </div>
            <h3>Fasilitas Lengkap</h3>
            <p class="card-text">Didukung oleh laboratorium modern, akses internet cepat, dan lingkungan belajar yang nyaman untuk mendukung proses pembelajaran.</p>
            <button class="btn-outline">Lihat Fasilitas →</button>
        </div>
    </main>

    <!-- 4. DATA MAHASISWA & FORMULIR PENDAFTARAN -->
    <section class="data-form-section">
        
        <!-- Tabel Akademik -->
        <div class="content-box">
            <div class="box-header">
                <i class="fas fa-user-graduate"></i>
                <h3>Data Mahasiswa dan Nilai Akademik</h3>
            </div>
            <p class="box-subtitle">Berikut adalah data mahasiswa program studi Sistem Informasi:</p>
            <div class="table-container">
                <table>
                    <thead>
                        <tr>
                            <th>No</th>
                            <th>NIM</th>
                            <th>Nama Mahasiswa</th>
                            <th>Program Studi</th>
                            <th class="text-center">Nilai Akhir</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>1</td>
                            <td>2024001</td>
                            <td class="font-bold">Andi Pratama</td>
                            <td>Sistem Informasi</td>
                            <td class="text-center score">85</td>
                        </tr>
                        <tr>
                            <td>2</td>
                            <td>2024002</td>
                            <td class="font-bold">Siti Rahma</td>
                            <td>Sistem Informasi</td>
                            <td class="text-center score">92</td>
                        </tr>
                        <tr>
                            <td>3</td>
                            <td>2024003</td>
                            <td class="font-bold">Budi Santoso</td>
                            <td>Teknik Informatika</td>
                            <td class="text-center score">78</td>
                        </tr>
                        <tr>
                            <td>4</td>
                            <td>2024004</td>
                            <td class="font-bold">Dewi Fitri</td>
                            <td>Teknik Informatika</td>
                            <td class="text-center score">88</td>
                        </tr>
                        <tr>
                            <td>5</td>
                            <td>2024005</td>
                            <td class="font-bold">Rizky Maulana</td>
                            <td>Sistem Informasi</td>
                            <td class="text-center score">90</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Formulir Pendaftaran -->
        <div class="content-box">
            <div class="box-header">
                <i class="fas fa-edit"></i>
                <h3>Formulir Pendaftaran Mahasiswa</h3>
            </div>
            <p class="box-subtitle">Isi data di bawah untuk melakukan pendaftaran:</p>
            <form class="registration-form">
                <div class="form-group">
                    <label>Nama Lengkap *</label>
                    <input type="text" placeholder="Masukkan nama lengkap">
                </div>
                <div class="form-group">
                    <label>NIM *</label>
                    <input type="text" placeholder="Masukkan NIM">
                </div>
                <div class="form-group">
                    <label>Program Studi *</label>
                    <select>
                        <option>Pilih Program Studi</option>
                        <option>S1 - Sistem Informasi</option>
                        <option>S1 - Teknik Informatika</option>
                    </select>
                </div>
                <div class="form-group">
                    <label>Email *</label>
                    <input type="email" placeholder="Masukkan email">
                </div>
                <div class="form-group full-width">
                    <label>Pesan / Keterangan</label>
                    <textarea rows="3" placeholder="Tulis pesan atau keterangan tambahan"></textarea>
                </div>
                <div class="form-group full-width">
                    <button type="submit" class="btn-submit">
                        <i class="fas fa-paper-plane"></i>
                        <span>Kirim Pendaftaran</span>
                    </button>
                </div>
            </form>
        </div>
    </section>

    <!-- FOOTER -->
    <footer>
        <div class="footer-container">
            <div class="footer-logo">
                <i class="fas fa-graduation-cap"></i>
                <span class="footer-title">STTI NIIT I-Tech</span>
                <span class="footer-address">Jl. A.R. Hakim No. 21, Jakarta Pusat</span>
            </div>
            <div class="footer-socials">
                <a href="#"><i class="fab fa-facebook-f"></i></a>
                <a href="#"><i class="fab fa-instagram"></i></a>
                <a href="#"><i class="fab fa-youtube"></i></a>
                <a href="#"><i class="fab fa-linkedin-in"></i></a>
            </div>
            <p class="copyright">&copy; 2026 STTI NIIT I-Tech. All rights reserved.</p>
        </div>
    </footer>

</body>
</html>
